{
  "name": "DualCommander Cline sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/project,type=bind",
  "workspaceFolder": "/workspaces/project",
  "containerUser": "developer",
  "remoteUser": "developer",
  "updateRemoteUserUID": true,
  "userEnvProbe": "none",
  "privileged": false,
  "capAdd": [],
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges:true"
  ],
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.cline/devcontainer-profiles/90c457713ac24cfd,target=/opt/cline-profile,type=bind,readonly"
  ],
  "initializeCommand": [
    "sh", "${localWorkspaceFolder}/.devcontainer/cline-settings.sh", "snapshot",
    "${localEnv:HOME}${localEnv:USERPROFILE}/.cline/devcontainer-profiles/90c457713ac24cfd"
  ],
  "postCreateCommand": [
    "sh", "/workspaces/project/.devcontainer/cline-settings.sh", "seed", "/opt/cline-profile"
  ],
  "forwardPorts": [],
  "containerEnv": {
    "NODE_OPTIONS": "--require=/usr/local/lib/vscode-memory.cjs",
    "CLINE_DIR": "/home/developer/.cline",
    "CLINE_DATA_DIR": "/home/developer/.cline/data",
    "SSH_AUTH_SOCK": "",
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_CONFIG_GLOBAL": "/dev/null",
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "credential.helper",
    "GIT_CONFIG_VALUE_0": "",
    "GIT_CONFIG_KEY_1": "safe.directory",
    "GIT_CONFIG_VALUE_1": "/workspaces/project",
    "GIT_TERMINAL_PROMPT": "0"
  },
  "remoteEnv": {
    "SSH_AUTH_SOCK": "",
    "DISPLAY": "",
    "WAYLAND_DISPLAY": ""
  },
  "customizations": {
    "vscode": {
      "extensions": ["saoudrizwan.claude-dev@4.1.26"],
      "settings": {
        "search.onlyOpenEditors": false,
        "search.useIgnoreFiles": false,
        "remote.extensionKind": {
          "saoudrizwan.claude-dev": ["workspace"]
        },
        "remote.autoForwardPorts": false,
        "git.terminalAuthentication": false,
        "git.useIntegratedAskPass": false
      }
    }
  }
}
