#!/bin/sh
# Cline hook: after any file-editing tool touches Go/testdata, run make check
# and push result into agent context; failure = agent sees errors immediately.
input=$(cat)
echo "$input" | grep -qE '"(write_to_file|replace_in_file|editor|apply_patch|create_new_file|new_rule)"' || { echo '{"cancel":false}'; exit 0; }
echo "$input" | grep -qE '"(path|pathInProject)" *: *"[^"]*(\.go|go\.mod|go\.sum|testdata[^"]*)"' || { echo '{"cancel":false}'; exit 0; }
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
if out=$(make -C "$root" check 2>&1); then
  msg="make check PASSED"
else
  msg="make check FAILED - fix before continuing (skill test-every-change):
$(printf '%s' "$out" | tail -40)"
fi
printf '%s' "$msg" | python3 -c 'import json,sys; print(json.dumps({"cancel": False, "contextModification": sys.stdin.read()}))'
